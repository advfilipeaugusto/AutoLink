rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.uid; }
    match /owners/{uid} { allow read, write: if me() == uid; }
    match /owners/{uid}/{rest=**} { allow read, write: if me() == uid; }
    match /profiles/{uid} {
      allow get: if me() == uid || isAdmin();
      allow list: if isAdmin();
      allow create: if me() == uid && request.resource.data.doc is string
        && (request.resource.data.doc.size() == 11 || request.resource.data.doc.size() == 14);
      allow update: if me() == uid && request.resource.data.doc == resource.data.doc
        && request.resource.data.name == resource.data.name && request.resource.data.docType == resource.data.docType;
    }
    match /accidents/{id} {
      allow get, list: if request.auth != null && (resource.data.authorId == me() || isAdmin());
      allow create: if request.auth != null && request.resource.data.authorId == me() && request.resource.data.status == 'pending'
        && request.resource.data.photo is string && request.resource.data.photo.size() < 950000;
      allow update, delete: if isAdmin();
    }
    match /ratings/{id} {
      allow get, list: if request.auth != null && (resource.data.ownerId == me() || isAdmin());
      allow create: if request.auth != null && request.resource.data.by == me()
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && get(/databases/$(db)/documents/cars/$(request.resource.data.carId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(db)/documents/cars/$(request.resource.data.carId)).data.get('fleet', false) == true;
    }
    match /reports/{r} { allow create: if request.resource.data.ownerId == me(); }
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(me())); }
    match /admins/{uid} { allow get: if me() == uid; }
    match /stickerSecrets/{code} { allow read, write: if isAdmin(); }
    match /stickers/{code} {
      allow get: if request.auth != null;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.get('ownerId', null) == me() && request.resource.data.carId == null && request.resource.data.ownerId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carId', 'ownerId', 'activatedAt', 'activationPin']))
        || (resource.data.get('carId', null) == null
        && request.resource.data.ownerId == me()
        && get(/databases/$(db)/documents/cars/$(request.resource.data.carId)).data.ownerId == me()
        && request.resource.data.activationPin == get(/databases/$(db)/documents/stickerSecrets/$(code)).data.pin
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carId', 'ownerId', 'activatedAt', 'activationPin']));
    }
    match /alerts/{id} {
      allow get, list: if request.auth != null && (resource.data.status == 'approved' || resource.data.authorId == me() || isAdmin());
      allow create: if request.auth != null && request.resource.data.authorId == me() && request.resource.data.status == 'pending'
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300;
      allow update, delete: if isAdmin();
    }
    match /adRequests/{id} {
      allow create: if request.auth != null && request.resource.data.userId == me();
      allow read, update, delete: if isAdmin();
    }
    match /tickets/{id} {
      allow get, list: if request.auth != null && (resource.data.userId == me() || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == me();
      allow update: if isAdmin() || (resource.data.userId == me() && request.resource.data.userId == me());
      match /messages/{m} {
        allow read: if isAdmin() || get(/databases/$(db)/documents/tickets/$(id)).data.userId == me();
        allow create: if (isAdmin() && request.resource.data.from == 'team')
          || (get(/databases/$(db)/documents/tickets/$(id)).data.userId == me() && request.resource.data.from == 'user');
      }
    }
    match /cars/{carId} {
      allow get: if request.auth != null;
      allow list: if resource.data.ownerId == me() || isAdmin();
      allow create: if request.resource.data.ownerId == me();
      allow update, delete: if resource.data.ownerId == me() || isAdmin();
    }
    match /chats/{chatId} {
      function part() { return me() == resource.data.ownerId || me() == resource.data.visitorId; }
      allow get, list: if request.auth != null && (part() || isAdmin());
      allow update: if request.auth != null && (me() == resource.data.ownerId ||
        (me() == resource.data.visitorId && resource.data.get('blocked', false) == false &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'updatedAt'])));
      allow create: if request.resource.data.visitorId == me()
        && get(/databases/$(db)/documents/cars/$(request.resource.data.carId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(db)/documents/cars/$(request.resource.data.carId)).data.active == true
        && !exists(/databases/$(db)/documents/owners/$(request.resource.data.ownerId)/blocked/$(me()))
        && (request.resource.data.get('visitorVerified', false) == false || exists(/databases/$(db)/documents/profiles/$(me())));
      match /messages/{m} {
        function chat() { return get(/databases/$(db)/documents/chats/$(chatId)).data; }
        allow read: if me() == chat().ownerId || me() == chat().visitorId;
        allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 500 &&
          ((me() == chat().ownerId && request.resource.data.from == 'owner') ||
           (me() == chat().visitorId && request.resource.data.from == 'visitor' && chat().get('blocked', false) == false));
      }
    }
  }
}
